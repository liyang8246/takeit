{
  "name": "@liyang8246/takeit",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@12.21.0",
  "description": "Control one explicitly authorized browser tab with a one-shot CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyang8246/takeit.git"
  },
  "bin": { "takeit": "dist/cli.mjs" },
  "files": ["dist/cli.mjs"],
  "engines": { "node": ">=22.18.0" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node build.mjs",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm test",
    "dev": "node src/cli/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "selftest": "pnpm run build && node dev/protocol.test.ts && node dev/cli.test.ts && node dev/selftest.ts && node dev/snapshot.test.ts && node dev/cdp.test.ts && node dev/extension.test.ts",
    "test": "pnpm run selftest",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@resvg/resvg-js": "catalog:dev",
    "@types/chrome": "catalog:dev",
    "@types/node": "catalog:dev",
    "esbuild": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "eslint-plugin-slop": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:dev",
    "jquery": "catalog:inlined",
    "typescript": "catalog:dev"
  }
}
