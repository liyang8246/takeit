{
  "manifest_version": 3,
  "name": "Page Handover · 网页接管",
  "version": "0.4.0",
  "description": "把整个标签页交给本地 AI agent 操作，不装 MCP",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "debugger", "offscreen", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "bg.js" },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "交给 AI",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  }
}
